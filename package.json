{
  "name": "rankstudy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @rankstudy/api\" \"npm run dev -w @rankstudy/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @rankstudy/api",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @rankstudy/api",
    "infra:up": "docker compose up -d --wait",
    "infra:local": "node scripts/local-infra.mjs",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/mailparser": "^3.9.0",
    "@types/smtp-server": "^3.5.13",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "mailparser": "^3.9.36",
    "smtp-server": "^3.19.17"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
