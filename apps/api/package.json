    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.5",
