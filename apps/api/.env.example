PORT=3001
DATABASE_URL=postgresql://rankstudy:rankstudy_local@localhost:5432/rankstudy
WEB_ORIGIN=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RankStudy <no-reply@rankstudy.local>
VERIFICATION_TTL_MINUTES=30
RESEND_COOLDOWN_SECONDS=60
SESSION_TTL_DAYS=7
MATCH_INITIAL_RANGE=100
NODE_ENV=development

# Google Cloud: aplicación web OAuth. Nunca usar variables NEXT_PUBLIC para secretos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, equipo, clave y PEM (.p8) con saltos representados como \n.
# Apple requiere WEB_ORIGIN HTTPS, dominio y callback registrados.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
